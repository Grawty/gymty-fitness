# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin.
# .env dosyası ASLA sürüm kontrolüne eklenmemelidir.

APP_ENV=local
APP_TIMEZONE=Europe/Istanbul

# Rastgele, uzun bir değer olmalı. Üretmek için:
# php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Boş bırakılırsa uygulamanın bulunduğu klasör otomatik algılanır.
# Alt klasörde çalışıyorsanız örn: /projedosyalarim
BASE_URL=

DB_HOST=localhost
DB_NAME=gymty
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Saniye cinsinden hareketsizlik süresi (varsayılan: 2 saat)
SESSION_IDLE_TIMEOUT=7200
